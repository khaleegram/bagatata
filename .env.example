# Confirmed public website URL; omit canonicals and sitemap URLs while blank.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Contact delivery is unavailable until all three values are configured.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Only set this to an IP header overwritten by your trusted reverse proxy.
CONTACT_CLIENT_IP_HEADER=
# Generate a private random value before enabling trusted IP rate limiting.
CONTACT_RATE_LIMIT_SECRET=
